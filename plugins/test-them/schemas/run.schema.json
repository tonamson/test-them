{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "test them Run",
  "type": "object",
  "required": ["id", "target", "startedAt", "finishedAt", "cases", "findings"],
  "properties": {
    "id": { "type": "string" },
    "target": {
      "type": "object",
      "required": ["method", "url"],
      "properties": {
        "method": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "startedAt": { "type": "string" },
    "finishedAt": { "type": "string" },
    "baseUrl": { "type": "string" },
    "brand": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "product": { "type": "string" },
        "owner": { "type": "string" },
        "mark": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "operations": { "type": "integer" }
      }
    },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/case" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["id", "family", "title", "live", "startedAt", "elapsedMs", "request", "response", "verdict", "reason"],
      "properties": {
        "id": { "type": "string" },
        "family": { "enum": ["happy", "validation", "auth", "protocol", "contract", "spec", "ui"] },
        "title": { "type": "string" },
        "scenario": { "type": "string" },
        "purpose": { "type": "string" },
        "expectedText": { "type": "string" },
        "unexpected": {
          "type": ["object", "null"],
          "properties": {
            "kind": { "type": "string" },
            "text": { "type": "string" }
          }
        },
        "live": { "const": true },
        "startedAt": { "type": "string" },
        "elapsedMs": { "type": "number" },
        "verdict": { "enum": ["pass", "fail", "warn"] },
        "reason": { "type": "string" },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": { "type": "string" },
              "src": { "type": "string" }
            }
          }
        },
        "uiExpects": {
          "type": "object",
          "properties": {
            "hits": { "type": "array" },
            "misses": { "type": "array" }
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "required": ["severity", "caseId", "text"],
      "properties": {
        "severity": { "enum": ["fail", "warn", "info"] },
        "caseId": { "type": "string" },
        "text": { "type": "string" }
      }
    }
  }
}
